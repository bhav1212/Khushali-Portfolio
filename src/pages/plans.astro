---
import SiteLayout from '../layouts/SiteLayout.astro';
import ProjectCategoryNav from '../components/ProjectCategoryNav';
import PlanList from '../components/PlanList';
import collections from '../data/plans.json';
import {ui, type Language} from '../lib/i18n';
interface Props {language?:Language;}
const language=Astro.props.language||'en', text=ui[language];
---
<SiteLayout language={language} title={text.plans} description={text.plansCopy}>
  <section class="page-intro projects-intro page-gutter"><h1>{text.plans}</h1></section>
  <section class="page-gutter explorer-section"><ProjectCategoryNav language={language} active="plans"/><PlanList sheets={collections.flatMap(collection=>collection.sheets)} language={language} client:load/></section>
</SiteLayout>
