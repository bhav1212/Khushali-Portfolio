---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Gallery from '../../components/Gallery';
import ProjectLink from '../../components/ProjectLink.astro';
import Arrow from '../../components/Arrow.astro';
import {translatedProjects,contactEmail,type Project} from '../../data/portfolio';
import {roomLabels} from '../../lib/discovery';
import {ui,localPath,deRooms,categoryText,type Language} from '../../lib/i18n';
export function getStaticPaths(){return translatedProjects('en').map(project=>({params:{slug:project.slug},props:{project}}));}
interface Props{project:Project;language?:Language;}
const {project,language='en'}=Astro.props,text=ui[language],projects=translatedProjects(language),roomText=language==='de'?deRooms:roomLabels;
const hero=project.gallery[0],rooms=[...new Set(project.gallery.flatMap(image=>image.rooms))].filter(key=>roomText[key]);
const materials=[...new Set(project.gallery.flatMap(image=>image.materials))].slice(0,6);
const related=projects.filter(other=>other.id!==project.id&&other.category===project.category).slice(0,2);
const inquiry=`mailto:${contactEmail}?subject=${encodeURIComponent(project.title)}`;
---
<SiteLayout language={language} title={project.title} description={project.intro} image={hero.src}><div class="case-page" style={`--project-surface:${project.surface}`}><section class="case-intro page-gutter"><nav class="breadcrumbs" aria-label={text.chapters}><a href={localPath('/',language)}>{text.home}</a><span aria-hidden="true">/</span><a href={localPath('/projects',language)}>{text.projects}</a></nav><h1>{project.title}</h1><div class="case-labels"><span>{categoryText[language][project.category]}</span><span>{project.study?text.designStudy:text.visualisation}</span></div></section>
<figure class="case-hero">{hero.width<1000?<div class="case-study-spread">{project.gallery.slice(0,2).map(image=><img src={image.src} srcset={image.srcSet} sizes="(max-width:700px) 100vw,45vw" width={image.width} height={image.height} alt={image.caption} loading="eager" style={`max-width:${image.width}px`}/>)}</div>:<img src={hero.src} srcset={hero.srcSet} sizes="100vw" width={hero.width} height={hero.height} alt={hero.caption} loading="eager" fetchpriority="high" style="view-transition-name:project-image"/>}</figure>
<nav class="case-chapters page-gutter" aria-label={text.chapters}><a href="#story">{text.story}</a><a href="#gallery">{text.gallery} ({project.gallery.length})</a>{project.drawings.length>0&&<a href="#drawings">{text.sketching}</a>}{project.videos.length>0&&<a href="#walkthroughs">{text.films}</a>}{related.length>0&&<a href="#related">{text.related}</a>}</nav>
<section id="story" class="case-story page-gutter section-space" aria-label={text.designStory}><div class="case-narrative"><h2>{text.storyTitle}</h2><p class="lead-copy">{project.intro}</p><p>{project.detail}</p></div><aside class="case-notes"><dl><div><dt>{text.design}</dt><dd>Khushali Jain</dd></div><div><dt>{text.spacesExplored}</dt><dd>{rooms.map(key=>roomText[key]).join(', ')}</dd></div><div><dt>{text.materials}</dt><dd>{materials.join(', ')}</dd></div></dl><nav class="material-palette" aria-label={text.colours}>{project.palette.map(colour=><a href={`#${colour.imageId}`} style={`background:${colour.hex}`} data-colour={colour.hex} aria-label={`${text.colourView}: ${colour.hex}`} title={`${text.colourView}: ${colour.hex}`}></a>)}</nav><p class="palette-caption">{text.palette}</p><p class="palette-caption">{text.paletteHint}</p></aside></section>
{project.videos.length>0&&<section id="walkthroughs" class="walkthroughs page-gutter section-space"><div class="section-heading"><h2>{text.filmTitle}</h2><p>{text.filmCopy}</p></div><div class="video-grid">{project.videos.map(video=><figure><video controls playsinline preload="none" poster={video.poster} width="1280" height="720" aria-label={video.label}><source src={video.src} type="video/mp4"/><a href={video.src}>{text.download}: {video.label}</a></video><figcaption>{video.label}</figcaption></figure>)}</div></section>}
<section id="gallery" class="case-gallery page-gutter"><div class="section-heading"><h2>{text.closer}</h2><p>{text.galleryCopy}</p></div><Gallery images={project.gallery} title={project.title} language={language} client:load/></section>
{project.drawings.length>0&&<section id="drawings" class="drawing-section page-gutter section-space"><details class="drawing-details"><summary>{text.sketches}<span class="expand-mark" aria-hidden="true"></span></summary>{project.drawings.map(drawing=><figure class="drawing-figure"><a href={drawing.src} target="_blank" rel="noopener" aria-label={drawing.caption}><img src={drawing.src} srcset={drawing.srcSet} sizes="(max-width:700px) 100vw,70vw" width={drawing.width} height={drawing.height} alt={drawing.caption} loading="lazy"/></a><figcaption><span>{drawing.caption}</span><a class="inline-link" href={drawing.src} target="_blank" rel="noopener">{text.openPlan}<Arrow/></a></figcaption></figure>)}</details></section>}
<div class="case-inquiry page-gutter"><a class="button-link" href={inquiry}>{text.inquire}<Arrow/></a><a class="inline-link" href={localPath('/projects',language)}>{text.backProjects}<Arrow direction="left"/></a></div></div>
{related.length>0&&<section id="related" class="related-projects page-gutter section-space"><div class="section-heading"><h2>{text.relatedTitle}</h2></div><div class="related-grid">{related.map(other=><ProjectLink project={other} language={language}/>)}</div></section>}</SiteLayout>
